{
  "name": "ccb-admin",
  "version": "1.0.0",
  "description": "Library management system built on Google Sheets + Apps Script",
  "scripts": {
    "build": "node build.js main",
    "build:main": "node build.js main",
    "build:admin": "node build.js admin",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "push": "npm run build:main && clasp push",
    "push:admin": "npm run build:admin && clasp -P .clasp.admin.json push",
    "deploy": "npm run deploy:main",
    "deploy:main": "npm run build:main && clasp push --force && clasp deploy --deploymentId AKfycbxlopiT2jl_hGrmUOAUgzLrYvnjzBi6AkdXZWy1qSebzp8bjF_i8P0VRzbLspjpbZCARg",
    "deploy:admin": "npm run build:admin && clasp -P .clasp.admin.json push --force && clasp -P .clasp.admin.json deploy --deploymentId AKfycbzN_iL5NxKNha4dbeaUeKzk5pv0DylwjdIWVR7OociusnJt4cLCHFcj8j7so5IZnSjLTQ",
    "open": "clasp open",
    "open:main": "clasp open",
    "open:admin": "clasp -P .clasp.admin.json open",
    "logs": "clasp logs"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.83",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.27.2",
    "eslint": "^8.57.0",
    "googleapis": "^131.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "google-apps-script",
    "library-management",
    "google-sheets"
  ],
  "license": "MIT"
}
